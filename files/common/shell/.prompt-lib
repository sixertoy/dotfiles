# Portable bash (Ubuntu) / zsh (macOS) — à sourcer, ne pas exécuter.
# Prompt helpers partagés. Assemblage : files/ubuntu/shell/.prompt (bash), files/macos/shell/.prompt (zsh).

# Prefer 256-color terminfo when the terminal still advertises plain xterm
if [[ ${TERM:-} = xterm ]] && infocmp xterm-256color >/dev/null 2>&1; then
  export TERM='xterm-256color'
fi

# get current NodeJS version (via n / PATH)
function node_version() {
  local strVersion=''
  strVersion="$(node -v 2>/dev/null || echo 'unknown')"
  printf '(%s)' "${strVersion}"
}

function prompt_git() {
  local s=''
  local branchName=''

  # Check if the current directory is in a Git repository.
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = 'true' ]; then

    # check if the current directory is in .git before running git checks
    if [ "$(git rev-parse --is-inside-git-dir 2>/dev/null)" = 'false' ]; then

      # Pas de `git update-index` ici : il pose .git/index.lock à chaque prompt
      # et entre en conflit avec les opérations Git des IDE.

      # Check for uncommitted changes in the index.
      if ! git diff --quiet --ignore-submodules --cached 2>/dev/null; then
        s="${s}+"
      fi

      # Check for unstaged changes.
      if ! git diff-files --quiet --ignore-submodules -- 2>/dev/null; then
        s="${s}!"
      fi

      # Check for untracked files.
      if [ -n "$(git ls-files --others --exclude-standard)" ]; then
        s="${s}?"
      fi

      # Check for stashed files.
      if git rev-parse --verify refs/stash >/dev/null 2>&1; then
        s="${s}$"
      fi

    fi

    # Branche / SHA (git-utils) — hors repo : early return ci-dessus
    branchName="$(_git-branch-name || echo '(unknown)')"
    [ -z "$branchName" ] && branchName='(unknown)'

    [ -n "${s}" ] && s=" [${s}]"

    printf '%b' "${1}${branchName}${2}${s}"
  else
    return
  fi
}

if tput setaf 1 >/dev/null 2>&1; then
  tput sgr0 # reset colors
  bold=$(tput bold)
  reset=$(tput sgr0)
  # Solarized colors, taken from http://git.io/solarized-colors.
  black=$(tput setaf 0)
  blue=$(tput setaf 33)
  cyan=$(tput setaf 37)
  green=$(tput setaf 64)
  orange=$(tput setaf 166)
  purple=$(tput setaf 125)
  red=$(tput setaf 124)
  violet=$(tput setaf 61)
  white=$(tput setaf 15)
  yellow=$(tput setaf 136)
  grey=$(tput setaf 251)
else
  bold=''
  reset=$'\e[0m'
  black=$'\e[1;30m'
  blue=$'\e[1;34m'
  cyan=$'\e[1;36m'
  green=$'\e[1;32m'
  orange=$'\e[1;33m'
  purple=$'\e[1;35m'
  red=$'\e[1;31m'
  violet=$'\e[1;35m'
  white=$'\e[1;37m'
  yellow=$'\e[1;33m'
  grey=$'\e[1;37m'
fi

# Highlight the user name when logged in as root.
# USER est souvent absent en Docker / non-login ; id -u est fiable avec set -u.
if [[ "$(id -u)" -eq 0 ]]; then
  userStyle="${red}"
else
  userStyle="${orange}"
fi

# Highlight the hostname when connected via SSH.
if [[ -n "${SSH_TTY:-}" ]]; then
  hostStyle="${bold}${red}"
else
  hostStyle="${yellow}"
fi

PROMPT_USER=$(git config --get user.name 2>/dev/null || whoami)
