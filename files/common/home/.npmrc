# Auth registry : injectée localement par setup.sh dans ~/.npmrc (copie, jamais versionnée)

# Scripts autorisés pour npm install -g / npx (pas de package.json allowScripts)
allow-scripts=yarn
fund=false
audit=true
save-exact=false
engine-strict=true
# initialize project with default values
init-license=MIT
init-author-name=Matthieu
init-author-email=matthieu@sixertoy.com
init-author-url=https://sixertoy.com
init-version=0.1.0
